# -----------------------------------------------------------------------------
# csb-hcs-dcs — bind (creates a DCS account)
# Run:  cd terraform/dcs/bind
#       tofu init
#       tofu plan  -var-file=../../../examples/shared.tfvars -var-file=../../../examples/dcs/bind.tfvars
#       tofu apply -var-file=../../../examples/shared.tfvars -var-file=../../../examples/dcs/bind.tfvars
# Auth: export HCS_ACCESS_KEY=... HCS_SECRET_KEY=...   (or IAM user/password)
#       export HCS_INSECURE=true                        (self-signed certs)
# Template: the working copy examples/dcs/bind.tfvars is gitignored (materialized
# by make gen-config, restored by make bind-tfvars-reset); edit the copy, never this file.
# Fill OUTPUT-* placeholders from the provision run's `tofu output`.
# -----------------------------------------------------------------------------
# --- binding credential ---
# bind_mode = "account" creates a per-binding DCS account (needs an ha/cluster/
# proxy instance AND the site flag feature.dcs2.support.acl; without the flag
# bind fails with DCS.4967 "The tenant does not support ACL"). "passthrough"
# returns the instance password instead and works on any site.
bind_mode    = "account"                         # account | passthrough
account_name = "appuser"
account_role = "write"                           # read | write

# --- values from the provision run's outputs ---
instance_id  = "OUTPUT-instance_id"
domain_name  = "OUTPUT-domain_name"
port         = 6379
