# -----------------------------------------------------------------------------
# csb-hcs-csms — bind (reads back the secret)
# Run:  cd terraform/csms/bind
#       tofu init
#       tofu plan  -var-file=../../../examples/shared.tfvars -var-file=../../../examples/csms/bind.tfvars
#       tofu apply -var-file=../../../examples/shared.tfvars -var-file=../../../examples/csms/bind.tfvars
# Auth: export HCS_ACCESS_KEY=... HCS_SECRET_KEY=...   (or IAM user/password)
#       export HCS_INSECURE=true                        (self-signed certs)
# Template: the working copy examples/csms/bind.tfvars is gitignored (materialized
# by make gen-config, restored by make bind-tfvars-reset); edit the copy, never this file.
# Fill OUTPUT-* placeholders from the provision run's `tofu output`.
# -----------------------------------------------------------------------------
# --- values from the provision run's outputs ---
secret_name = "OUTPUT-name"
