# -----------------------------------------------------------------------------
# csb-hcs-obs — bind (passthrough; optional policy grant)
# Run:  cd terraform/obs/bind
#       tofu init
#       tofu plan  -var-file=../../../examples/shared.tfvars -var-file=../../../examples/obs/bind.tfvars
#       tofu apply -var-file=../../../examples/shared.tfvars -var-file=../../../examples/obs/bind.tfvars
# Auth: export HCS_ACCESS_KEY=... HCS_SECRET_KEY=...   (or IAM user/password)
#       export HCS_INSECURE=true                        (self-signed certs)
# Template: the working copy examples/obs/bind.tfvars is gitignored (materialized
# by make gen-config, restored by make bind-tfvars-reset); edit the copy, never this file.
# Fill OUTPUT-* placeholders from the provision run's `tofu output`.
# -----------------------------------------------------------------------------
# --- values from the provision run's outputs ---
bucket_name         = "OUTPUT-bucket_name"
bucket_domain_name  = "OUTPUT-bucket_domain_name"

# --- optional policy grant (attaches a bucket policy; the identity is NOT created here) ---
# grant_principal is passed verbatim as the policy principal. Formats:
#   domain/<account-id>:user/<user>       # an IAM/VDC user
#   domain/<account-id>:group/<group>     # a user group (if the site's OBS supports it)
#   domain/<account-id>:agency/<name>     # an agency
grant_permission    = "read-write"        # read = list + get; read-write = + put + delete
# grant_principal   = "domain/<account-id>:user/<user>"   # uncomment to grant
