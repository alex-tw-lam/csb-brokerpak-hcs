# Direnv template for local development of the HCS brokerpak.
# Copy the relevant block and fill in your HCS site values.

# --- Broker API ---
export SECURITY_USER_NAME=user
export SECURITY_USER_PASSWORD=pass
export DB_TYPE=sqlite3
export DB_PATH=/tmp/csb-hcs.db

# --- HCS provider connection (all read natively by terraform-provider-hcs) ---
# AK/SK auth:
export HCS_ACCESS_KEY=your-access-key
export HCS_SECRET_KEY=your-secret-key
# ...or domain/user/password (Keystone v3) auth:
# export HCS_DOMAIN_NAME=your-domain
# export HCS_USER_NAME=your-user
# export HCS_USER_PASSWORD=your-password
# Shared:
export HCS_CLOUD=hcs.example.com          # cloud domain; service endpoints are derived from it
export HCS_REGION_NAME=cn-north-1         # region / project fallback
export HCS_AUTH_URL=https://iam-apigateway-proxy.hcs.example.com/v3
export HCS_INSECURE=true                  # typical for HCS deployments with self-signed certs

# --- Plans for services with site-specific flavor codes ---
export GSB_SERVICE_CSB_HCS_MYSQL_PLANS='[{"name":"default","id":"d5b301c3-1505-47dc-9a26-508c8e82a2ce","description":"Default RDS for MySQL plan","display_name":"default","flavor":"rds.mysql.large.4.single","storage_gb":100}]'
export GSB_SERVICE_CSB_HCS_ELB_PLANS='[{"name":"default","id":"1d1c9366-6f51-4f51-8eb0-6a1a29f36c1e","description":"Default ELB plan","display_name":"default","l4_flavor_id":"CHANGE_ME","l7_flavor_id":"CHANGE_ME"}]'
export GSB_SERVICE_CSB_HCS_GAUSSDB_PLANS='[{"name":"default","id":"6d3b9c58-8dd9-4fa3-a21b-6e7a8a2f19f5","description":"Default GaussDB plan","display_name":"default","flavor":"CHANGE_ME"}]'

# --- Defaults applied to every provision request ---
export GSB_PROVISION_DEFAULTS='{"region":"cn-north-1","cloud":"hcs.example.com"}'
