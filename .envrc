# Direnv template for local development of the HCS brokerpak.
# Real secrets belong in .env (gitignored); this file loads it if present:
if [ -f .env ]; then
  set -a
  . ./.env
  set +a
fi

# --- Broker API (dev defaults; override in .env) ---
export SECURITY_USER_NAME=user
export SECURITY_USER_PASSWORD=pass
export DB_TYPE=sqlite3
export DB_PATH=/tmp/csb-hcs.db

# --- Static site configuration: one file, two outputs ---
# Edit config/site-values.yaml (connection, tofu instance inputs), then run
# `make gen-config` to generate BOTH:
#   hcs-broker.yaml                 -> csb serve --config hcs-broker.yaml
#   examples/<service>/provision.tfvars -> direct OpenTofu runs
# Any hcs.* or service.*.plans key may still be overridden with HCS_* / GSB_SERVICE_*
# environment variables (they win over the file).

# --- Credentials: put real values in .env (gitignored, auto-loaded above) ---
# .env example (AK/SK auth):
#   HCS_ACCESS_KEY=...
#   HCS_SECRET_KEY=...
# ...or IAM login (Keystone v3):
#   HCS_DOMAIN_NAME=mydomain
#   HCS_USER_NAME=csb
#   HCS_USER_PASSWORD=...

# --- Plans ---
# csb-hcs-csms ships its inline plan in the service definition; it can be
# overridden with the same variable pattern if ever needed.
# export GSB_SERVICE_CSB_HCS_CSMS_PLANS='[{"name":"default","id":"<uuid>","description":"...","display_name":"default"}]'

# --- Defaults applied to every provision request ---
export GSB_PROVISION_DEFAULTS='{"region":"cn-north-1","cloud":"hcs.example.com"}'
