# =============================================================================
# Site values — the single source of truth for the HCS brokerpak.
#
# Edit ONLY this file, then regenerate everything:
#
#     make gen-config
#
# which writes:
#   hcs-broker.yaml                  — broker config (csb serve --config ...)
#   examples/<service>/provision.tfvars — inputs for direct OpenTofu runs
#
# The bind tfvars (examples/<service>/bind.tfvars) contain per-binding choices
# and placeholders for the provision outputs, so they are not generated.
# =============================================================================

connection:
  region: cn-north-1
  project_name: cn-north-1           # HCS project (tenant); commonly the same as region
  cloud: hcs.example.com            # REQUIRED — service endpoints are derived from it
  insecure: true                    # typical for self-signed certificates
  # auth_url: https://iam-apigateway-proxy.hcs.example.com/v3

# -----------------------------------------------------------------------------
# Per-instance inputs for direct OpenTofu runs (NOT broker configuration —
# these stay per ServiceInstance parameters when going through the broker).
# -----------------------------------------------------------------------------
instances:
  csms:
    secret_name: csb-test-secret
