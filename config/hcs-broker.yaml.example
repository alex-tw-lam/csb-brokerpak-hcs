# CSB configuration file for the HCS brokerpak.
#
#   csb serve --config hcs-broker.yaml
#
# Everything static lives here. Only credentials are injected via the environment
# (see the env section at the bottom) — environment variables win over this file
# for any key listed in the manifest's env_config_mapping, but the file is the
# intended primary source.

hcs:
  # Shared connection settings (HCS_* environment variables with the same meaning
  # also work natively in terraform-provider-hcs).
  cloud: hcs.example.com            # REQUIRED — service endpoints are derived from it
  region: cn-north-1
  auth_url: https://iam-apigateway-proxy.hcs.example.com/v3
  insecure: true                    # typical for self-signed certificates

  # Site network: one shared VPC, one subnet per service, security groups by name.
  vpc_name: vpc-default
  ecs:
    subnet_name: subnet-ecs
    security_group_name: sg-ecs
  rds_postgresql:
    subnet_name: subnet-rds-pg
    security_group_name: sg-rds-pg
  dcs:
    subnet_name: subnet-dcs
  elb:
    subnet_name: subnet-elb
  gaussdb:
    subnet_name: subnet-gaussdb

# Plans for services whose sizing values are site-specific. Inline plans can be
# replaced the same way for any service (service.<name>.plans, JSON as a string).
service:
  csb-hcs-elb:
    plans: '[{"name":"default","id":"1d1c9366-6f51-4f51-8eb0-6a1a29f36c1e","description":"Default ELB plan","display_name":"default","l4_flavor_id":"CHANGE_ME","l7_flavor_id":"CHANGE_ME"}]'

# Optional: defaults applied to every provision request and labels added to every
# provisioned resource.
# provision:
#   defaults: '{"region":"cn-north-1"}'
# brokerpak:
#   config: '{"global_labels":[{"key":"team","value":"platform"}]}'
#
# Broker API and storage can also live here instead of the environment:
# security:
#   user:
#     name: user
#     password: changeme
# db:
#   type: sqlite3            # or mysql with host/port/name/username/password
#   path: /data/csb.db

# ---------------------------------------------------------------------------
# Environment (secrets only — inject at runtime, not in this file):
#
#   AK/SK auth:        HCS_ACCESS_KEY / HCS_SECRET_KEY
#   ...or IAM login:   HCS_DOMAIN_NAME / HCS_USER_NAME / HCS_USER_PASSWORD
#   Broker API auth:   SECURITY_USER_NAME / SECURITY_USER_PASSWORD
#   Database:          DB_PASSWORD (with db.type: mysql)
# ---------------------------------------------------------------------------
